<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Strictly block public HTTP access to sensitive files and directories
    RewriteRule ^\.env.* - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor)(\/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml) - [F,L,NC]

    # 2. Allow direct access to install.php if requested
    RewriteRule ^install\.php$ install.php [L,NC]

    # 3. Transparently route all other web traffic to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
